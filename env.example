# Base URL of the mapi backend (no trailing slash).
# The scanner calls POST ${VITE_API_BASE_URL}/v1/vibecheck/scan
VITE_API_BASE_URL=https://api.ammarramma.dev

# Sponsor buttons. The first entry is the primary CTA.
# JSON array of { label, url, icon }; icon is coffee | heart | github | star | link.
# Empty or missing hides the support section.
VITE_SPONSORS='[{"label":"Buy Ammar a Coffee","url":"https://ko-fi.com/ammarramma","icon":"coffee"},{"label":"Join the Tribe","url":"https://sociabuzz.com/ammarramma/tribe","icon":"heart"},{"label":"Sponsor on GitHub","url":"https://github.com/sponsors/ammarramma","icon":"github"}]'

# Optional external link. Leave empty to hide it.
VITE_PORTFOLIO_URL=https://ammarramma.dev

# Public URL this app is deployed to (used for canonical/OG tags at build time).
VITE_SITE_URL=https://scan.ammarramma.dev

# --- Local development only ---------------------------------------------
# The production API allowlists https://scan.ammarramma.dev, so a browser on
# localhost cannot call it directly. With the two vars below, the browser calls
# Vite itself and Vite proxies /v1/* and /healthz to the API. Put them in .env.local:
#
#   VITE_DEV_USE_PROXY=true
#   VITE_DEV_API_TARGET=https://api.ammarramma.dev
#
# They are ignored by production builds.
VITE_DEV_USE_PROXY=false
VITE_DEV_API_TARGET=https://api.ammarramma.dev
